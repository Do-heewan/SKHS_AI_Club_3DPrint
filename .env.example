# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env 는 절대 GitHub에 올리지 마세요)

# Claude 콘솔(platform.claude.com)에서 발급한 API 키
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (Project Settings > API). 비워 두면 data/db.json 파일에 저장 (로컬 테스트용)
# service_role 키는 모든 데이터에 접근할 수 있으니 절대 공개하지 마세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 사용할 모델. 비용을 줄이려면 claude-sonnet-5-5
CLAUDE_MODEL=claude-opus-5-5
# 생각 깊이: low | medium | high
CLAUDE_EFFORT=medium

# 동아리 이름 3개 (쉼표로 구분)
CLUBS=AI 동아리 1,AI 동아리 2,AI 동아리 3

# 학생 입장 코드 (수업 시간에 칠판에 적어 주세요). 비워 두면 코드 없이 입장
ACCESS_CODE=skhs2026

# /admin.html 관리자 페이지 비밀번호
ADMIN_PASSWORD=change-me

# 학생 1명당 하루 요청 횟수 제한
DAILY_MESSAGE_LIMIT=40
# 동시에 Claude에 보내는 최대 요청 수 (넘으면 대기열에서 기다림)
MAX_CONCURRENT=8

PORT=3000
